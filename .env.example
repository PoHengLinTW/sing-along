# Copy to .env for local development. Every variable is validated at API startup
# (apps/api/src/config.ts); the API refuses to start if one is missing or invalid.

# HTTP port for the API (dev proxy in apps/web/vite.config.ts expects 3100)
PORT=3100

# PostgreSQL connection string (docker-compose.dev.yml uses host port 5433)
DATABASE_URL=postgres://singalong:singalong@localhost:5433/singalong

# S3-compatible storage. Dev: RustFS from docker-compose.dev.yml. Prod: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=sing-along
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for RustFS (path-style URLs), false for R2
S3_FORCE_PATH_STYLE=true

# Origin the browser loads the app from (used for CORS/links)
PUBLIC_ORIGIN=http://localhost:5173

# Lifetime of presigned upload/download URLs, in seconds (60-86400)
PRESIGN_TTL_SECONDS=900

# Storage caps (PRD 5.9). Optional: the values below are the defaults.
# MAX_FILE_MB=60
# MAX_TRACK_MINUTES=10
# MAX_TRACKS_PER_PROJECT=10
# MAX_PROJECTS=100
# MAX_STORAGE_GB=8

# When the nightly cleanup of abandoned uploads runs (cron pattern, server local time), or "off".
# CLEANUP_CRON=30 3 * * *

# Set by the Docker image; leave unset in dev (Vite serves the web app, source migrations are used).
# WEB_DIST_DIR=/app/web
# MIGRATIONS_DIR=/app/drizzle
