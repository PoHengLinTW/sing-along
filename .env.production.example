# Copy to .env next to docker-compose.yml on the server and fill in every value.
# (This file is read by `docker compose`; the dev .env for `pnpm dev` is a different file.)

# Postgres password. Letters and digits only (it goes into a connection URL unescaped).
POSTGRES_PASSWORD=change-me-letters-and-digits-only

# Cloudflare R2 (README, "R2 setup"). The endpoint is https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=sing-along
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The address people open the app at; the R2 CORS policy must allow exactly this origin.
PUBLIC_ORIGIN=https://sing.example.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker). The tunnel's
# public hostname must point to http://app:3100
TUNNEL_TOKEN=

# Optional. The values below are the defaults.
# MAX_FILE_MB=60
# MAX_TRACK_MINUTES=10
# MAX_TRACKS_PER_PROJECT=10
# MAX_PROJECTS=100
# MAX_STORAGE_GB=8
# CLEANUP_CRON=30 3 * * *
# APP_IMAGE=sing-along:latest
# CLOUDFLARED_TAG=latest
